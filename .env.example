# Local development (Node.js 22+ and PostgreSQL 16).
DATABASE_URL="postgresql://alhaytham:CHANGE_ME@127.0.0.1:5432/alhaytham?schema=public"
NEXT_PUBLIC_SITE_URL=http://localhost:3005
# openssl rand -hex 32
ADMIN_SESSION_SECRET=CHANGE_ME
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=عبدالرحمن
# Trust only a reverse proxy which overwrites X-Client-IP; keep 0 for direct local use.
TRUST_PROXY=0
# Optional absolute persistent directory. Default: ./data/uploads
# UPLOAD_DIR=/var/lib/alhaytham/uploads

# ---- حسابات الزبائن (دخول برمز بريدي) ----
# استخدم بيانات SMTP من مزود البريد الذي تختاره.
# بلا SMTP_URL في التطوير تُكتب الرسائل في data/outbox.log بدل الإرسال.
# SMTP_URL=smtp://user:password@smtp-relay.brevo.com:587
# MAIL_FROM="الهيثم — نحل وعسل <no-reply@alhaythamhoney.sy>"

# المهام الدورية: الحملات المعتمدة وتذكير السلة والتنظيف. انظر deploy/VPS.md.
# ولّد سراً منفصلاً باستخدام openssl rand -hex 32 ثم ضعه هنا.
# CRON_SECRET=

# ---- قاعدة البيانات ----
# محلياً (بدون Docker): postgresql://postgres:postgres@localhost:5432/alhaytham?schema=public
# مع docker-compose: اسم الخدمة هو db
DATABASE_URL="postgresql://alhaytham:CHANGE_ME@db:5432/alhaytham?schema=public"

# تُستخدم من docker-compose لإنشاء قاعدة البيانات
POSTGRES_USER=alhaytham
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=alhaytham

# ---- حساب الأدمن الأولي (يُستخدم مرة واحدة عند تشغيل npm run db:seed) ----
# ملاحظة: إن احتوت كلمة المرور على # ضعها بين علامتي اقتباس "..."
ADMIN_USERNAME=admin
ADMIN_PASSWORD="ضع_كلمة_مرور_قوية_هنا_١٢_حرف_على_الأقل"
ADMIN_NAME=عبدالرحمن

# سرّ توقيع جلسة الأدمن — نص عشوائي طويل (openssl rand -hex 32)
ADMIN_SESSION_SECRET=CHANGE_ME

# ---- عام ----
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://alhaythamhoney.sy

// الهيثم — نحل وعسل — مخطط قاعدة البيانات

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductCategory {
  HONEY
  SUPPLEMENT
  /// باقة من منتجات أخرى بسعر واحد
  BUNDLE
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model Product {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  desc         String
  benefit      String?
  image        String
  badge        String?
  price        Int?
  weight       String?
  category     ProductCategory   @default(HONEY)
  detailedInfo Json?
  inStock      Boolean           @default(true)
  /// الكمية المتبقية — null تعني «غير متتبَّعة». تُظهر شارة «بقي X فقط» تحت عتبة الإعدادات.
  stockQty     Int?
  published    Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  orderItems   OrderItem[]
  reviews      Review[]
  /// «يُشترى معه عادةً» — يختارها الأدمن يدوياً
  related      ProductRelation[] @relation("RelatedFrom")
  relatedBy    ProductRelation[] @relation("RelatedTo")
  articles     Article[]
  /// أحجام/أوزان المنتج بأسعار مختلفة — إن وُجدت فالسعر الأساسي هو «يبدأ من»
  variants     ProductVariant[]
  /// خصم الكمية: «3 فأكثر = خصم 10%»
  tiers        PriceTier[]
  /// مكوّنات الباقة (إن كانت الفئة BUNDLE)
  bundleItems  BundleItem[]      @relation("BundleOf")
  /// الباقات التي يدخل فيها هذا المنتج
  inBundles    BundleItem[]      @relation("BundleComponent")
  /// خصائص الفلترة (نوع الزهرة، المنطقة، الموسم…)
  attributes   AttributeValue[]
  stockAlerts  StockAlert[]

  @@index([published, sortOrder])
  @@map("products")
}

/// مكوّن باقة: الباقة ← المنتج وكميته. توفر الباقة = توفر كل مكوّناتها.
model BundleItem {
  bundleId  String
  bundle    Product @relation("BundleOf", fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation("BundleComponent", fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  sortOrder Int     @default(0)

  @@id([bundleId, productId])
  @@index([productId])
  @@map("bundle_items")
}

/// خاصية فلترة (Odoo attributes): «نوع الزهرة»، «المنطقة»، «الموسم»…
model Attribute {
  id        String           @id @default(cuid())
  name      String           @unique
  sortOrder Int              @default(0)
  values    AttributeValue[]
  createdAt DateTime         @default(now())

  @@map("attributes")
}

model AttributeValue {
  id          String    @id @default(cuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  sortOrder   Int       @default(0)
  products    Product[]

  @@unique([attributeId, value])
  @@map("attribute_values")
}

/// «أعلمني عند التوفر»: بريد ينتظر عودة المنتج؛ يُرسَل مرة واحدة ثم يُعلَّم notifiedAt.
model StockAlert {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  email      String
  customerId String?
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([productId, email])
  @@index([productId, notifiedAt])
  @@map("stock_alerts")
}

/// متغيّر منتج (Odoo variants): حجم أو وزن بسعر ومخزون مستقلّين تحت الرابط نفسه.
model ProductVariant {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  price     Int
  /// null = بلا تتبّع
  stockQty  Int?
  inStock   Boolean     @default(true)
  isDefault Boolean     @default(false)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  items     OrderItem[]

  @@index([productId, sortOrder])
  @@map("product_variants")
}

/// شريحة سعر كمية (Odoo pricelist): من الكمية minQty فصاعداً يُخصم discountPercent من سعر الوحدة.
model PriceTier {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty          Int
  discountPercent Int

  @@unique([productId, minQty])
  @@map("price_tiers")
}

/// علاقة «يُشترى معه عادةً» باتجاه واحد: المنتج ← ما يُقترح معه.
model ProductRelation {
  productId String
  product   Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedId String
  related   Product @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)

  @@id([productId, relatedId])
  @@index([relatedId])
  @@map("product_relations")
}

/// طلب مسجَّل لحظة ضغط «أكمل الطلب عبر واتساب». الدفع والتأكيد يتمّان خارج الموقع،
/// فيبدأ بحالة PENDING ويحدّثها الأدمن من اللوحة؛ الأسعار محسوبة على الخادم لا من المتصفح.
model Order {
  id            String         @id @default(cuid())
  /// مرجع قصير يظهر في رسالة واتساب وصفحة التتبع (HY-XXXXXX)
  reference     String         @unique
  status        OrderStatus    @default(PENDING)
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String?
  customerPhone String?
  customerCity  String?
  subtotal      Int
  discount      Int            @default(0)
  shipping      Int            @default(0)
  total         Int
  couponCode    String?
  /// منطقة الشحن المختارة (اسم المحافظة) وقت الطلب
  zoneName      String?
  /// نقاط استُخدمت في هذا الطلب (تُعاد عند الإلغاء) ونقاط مُنحت عند التأكيد
  pointsUsed    Int            @default(0)
  pointsEarned  Int            @default(0)
  promotionUses PromotionUse[]
  /// تفصيل الحساب كما عُرض للزبون (خصومات، عروض، شحن) — للمراجعة لا لإعادة الحساب
  breakdown     Json?
  /// ملاحظات داخلية للأدمن
  notes         String?
  confirmedAt   DateTime?
  items         OrderItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// معرّف البند في السلة (مثلاً mix:… للخلطات) — للتشخيص فقط
  cartId    String?
  name      String
  price     Int
  quantity  Int
  weight    String?
  image     String?
  /// وصفة الخلطة المخصّصة كما وصلت من السلة
  recipe    String?

  @@index([orderId])
  @@map("order_items")
}

/// تقييم عميل. لا يُنشر إلا بعد موافقة الأدمن — حماية من السبام والمحتوى المسيء.
model Review {
  id         String       @id @default(cuid())
  productId  String?
  product    Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  authorCity String?
  rating     Int
  body       String
  status     ReviewStatus @default(PENDING)
  /// حقل قديم محفوظ لتجنب فقد البيانات؛ لا يكفي لإثبات الشراء.
  orderRef   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  customer   Customer?    @relation(fields: [customerId], references: [id])
  customerId String?

  @@index([status, createdAt])
  @@index([productId, status])
  @@map("reviews")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// خلطة مخصّصة: قاعدة من العسل (يختار الزبون نوعه) + إضافات بجرعات يضبطها الخبير
/// ويستطيع الزبون تعديلها ضمن حدود. الكميات مُعرَّفة لمرطبان مرجعي وزنه baseSize.
model Mixture {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  tagline     String
  desc        String
  image       String?
  /// أحجام المرطبان المتاحة بالغرام — يضبطها الأدمن؛ الحجم يغيّر كمية العسل فقط
  sizes       Int[]               @default([250, 500, 1000])
  defaultSize Int                 @default(500)
  prepFee     Int                 @default(0)
  published   Boolean             @default(true)
  sortOrder   Int                 @default(0)
  ingredients MixtureIngredient[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([published, sortOrder])
  @@map("mixtures")
}

model MixtureIngredient {
  id           String  @id @default(cuid())
  mixtureId    String
  mixture      Mixture @relation(fields: [mixtureId], references: [id], onDelete: Cascade)
  name         String
  /// سطر قصير يبرّر الجرعة الموصى بها للزبون
  note         String?
  pricePerGram Int
  minGrams     Int
  maxGrams     Int
  recommended  Int
  step         Int     @default(5)
  sortOrder    Int     @default(0)

  @@index([mixtureId])
  @@map("mixture_ingredients")
}

enum MediaType {
  IMAGE
  VIDEO
}

/// لقطات استديو الهيثم — صور ومقاطع يرفعها الأدمن وتُعرض للزوار في /studio
model StudioPhoto {
  id        String    @id @default(cuid())
  url       String
  caption   String?
  type      MediaType @default(IMAGE)
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@map("studio_photos")
}

/// مقال في المدونة — يكتبه الأدمن بصيغة Markdown (مع السماح بـ HTML بسيط)،
/// ويُحوَّل إلى HTML مُعقَّم عند العرض. المسودّات لا تظهر إلا للأدمن.
model Article {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String
  keywords    String[]          @default([])
  image       String?
  body        String
  published   Boolean           @default(false)
  publishedAt DateTime          @default(now())
  /// المنتجات المذكورة في المقال — تُعرض كبطاقات شراء داخله وتربط المنتج بمقالاته
  products    Product[]
  revisions   ArticleRevision[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([published, publishedAt])
  @@map("articles")
}

/// نسخة سابقة من المقال تُحفظ عند كل تعديل يمسّ العنوان أو النص — للاستعادة عند الخطأ.
model ArticleRevision {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
  @@map("article_revisions")
}

enum CouponType {
  PERCENT
  FIXED
}

/// كوبون خصم يكتبه الزبون في السلة؛ يُحتسب محلياً ويُرسل ضمن رسالة واتساب.
/// لا عدّاد استخدام لأن الطلب يُتمّ خارج الموقع — الأدمن يعطّله يدوياً أو بتاريخ انتهاء.
model Coupon {
  id              String             @id @default(cuid())
  code            String             @unique
  type            CouponType         @default(PERCENT)
  /// نسبة مئوية (1–100) أو مبلغ ثابت بالليرة
  value           Int
  minOrder        Int                @default(0)
  /// سقف الخصم بالليرة للنسبة المئوية (اختياري)
  maxDiscount     Int?
  active          Boolean            @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  note            String?
  /// لا يُقبل إلا من زبون مسجّل الدخول
  requiresLogin   Boolean            @default(false)
  /// مرة واحدة لكل حساب (يتطلب تسجيل الدخول ضمناً)
  oncePerCustomer Boolean            @default(false)
  /// كوبون شخصي (ترحيب/إحالة): لا يقبله إلا هذا الحساب
  customerId      String?
  customer        Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// مصدر الكوبون الآلي: WELCOME أو REFERRAL — لحساب السقف الشهري
  source          String?
  redemptions     CouponRedemption[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([customerId])
  @@index([source, createdAt])
  @@map("coupons")
}

/// استخدام كوبون من حساب — يُسجَّل لحظة الضغط على «أكمل الطلب عبر واتساب»
model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subtotal   Int
  createdAt  DateTime @default(now())

  @@index([couponId, customerId])
  @@map("coupon_redemptions")
}

/// حساب زبون بلا كلمة مرور: الدخول برمز يُرسل إلى البريد. الهاتف للتوصيل والرسائل الجماعية.
model Customer {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String
  phone              String
  city               String?
  marketingOptIn     Boolean             @default(true)
  lastLoginAt        DateTime?
  /// رصيد نقاط الولاء الحالي (مجموع الحركات)
  points             Int                 @default(0)
  /// رمز الإحالة الشخصي (يُولَّد عند أول حاجة)
  referralCode       String?             @unique
  referredById       String?
  referredBy         Customer?           @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          Customer[]          @relation("Referrals")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  reviews            Review[]
  entries            DrawEntry[]
  redemptions        CouponRedemption[]
  jarCodes           JarCode[]
  orders             Order[]
  pointsHistory      PointsTransaction[]
  coupons            Coupon[]
  campaignRecipients CampaignRecipient[]

  @@index([phone])
  @@index([createdAt])
  @@map("customers")
}

enum PointsReason {
  ORDER_EARN
  ORDER_REDEEM
  ORDER_REFUND
  REFERRAL
  ADMIN
}

/// حركة نقاط ولاء — الرصيد في Customer.points هو مجموعها
model PointsTransaction {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  delta      Int
  reason     PointsReason
  orderId    String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([customerId, createdAt])
  @@index([reason, createdAt])
  @@map("points_transactions")
}

/// رمز دخول لمرة واحدة (6 أرقام) — يُخزَّن مُجزَّأً وينتهي خلال دقائق.
model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@map("login_codes")
}

enum DrawStatus {
  DRAFT
  OPEN
  CLOSED
  DRAWN
}

/// سحب (أسبوعي غالباً): الزبون المسجّل يُدخل رمز المرطبان المطبوع على الملصق ليشارك.
model Draw {
  id            String      @id @default(cuid())
  title         String
  prize         String
  description   String?
  startsAt      DateTime
  endsAt        DateTime
  status        DrawStatus  @default(DRAFT)
  /// 0 = بلا حد — كل مرطبان يمنح فرصة
  maxEntries    Int         @default(0)
  winnerEntryId String?     @unique
  winnerEntry   DrawEntry?  @relation("Winner", fields: [winnerEntryId], references: [id], onDelete: SetNull)
  entries       DrawEntry[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, endsAt])
  @@map("draws")
}

model DrawEntry {
  id         String   @id @default(cuid())
  drawId     String
  draw       Draw     @relation(fields: [drawId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jarCodeId  String   @unique
  jarCode    JarCode  @relation(fields: [jarCodeId], references: [id], onDelete: Cascade)
  wonDraw    Draw?    @relation("Winner")
  createdAt  DateTime @default(now())

  @@index([drawId, customerId])
  @@map("draw_entries")
}

/// رمز فريد يُطبع على كل مرطبان — يولّده الأدمن على دفعات ويُستخدم مرة واحدة فقط.
model JarCode {
  id        String     @id @default(cuid())
  code      String     @unique
  batch     String
  createdAt DateTime   @default(now())
  usedAt    DateTime?
  usedById  String?
  usedBy    Customer?  @relation(fields: [usedById], references: [id], onDelete: SetNull)
  entry     DrawEntry?

  @@index([batch])
  @@map("jar_codes")
}

/// إعدادات الموقع — صف واحد (id = "site") يحرّره الأدمن بلا نشر جديد.
model SiteSettings {
  id                        String   @id @default("site")
  /// رقم واتساب بالصيغة الدولية بلا + (مثال 963947931959)
  whatsappNumber            String   @default("963947931959")
  phoneDisplay              String   @default("+963947931959")
  email                     String?
  workingHours              String   @default("يومياً من 9 صباحاً حتى 9 مساءً")
  shippingCost              Int      @default(25000)
  /// 0 = لا توصيل مجاني
  freeShippingThreshold     Int      @default(500000)
  heroBadge                 String   @default("إرث عائلي موثوق منذ 1997")
  heroTitle                 String   @default("عسل طبيعي 100% من مراعي سوريا")
  heroHighlight             String   @default("الهيثم — نحل وعسل – منذ 1997")
  heroSubtitle              String   @default("نقدّم عسلًا 100% طبيعي، مفحوصًا مخبريًا، من الخلية إلى مائدتك بلا أي إضافات.")
  heroImage                 String?
  announcementEnabled       Boolean  @default(false)
  announcementText          String?
  announcementLink          String?
  lowStockThreshold         Int      @default(3)
  showRecentlyViewed        Boolean  @default(true)
  autoRelatedProducts       Boolean  @default(true)
  cartReminderEnabled       Boolean  @default(true)
  /// بعد كم ساعة من آخر تعديل تُعتبر السلة «متروكة»
  cartReminderHours         Int      @default(12)
  couponsEnabled            Boolean  @default(true)
  /// خصومات الكمية على المنتجات (تُعرّف لكل منتج)
  tieredPricingEnabled      Boolean  @default(true)
  /// العروض التلقائية في السلة
  promotionsEnabled         Boolean  @default(true)
  /// الشحن حسب المحافظة (وإلا تكلفة واحدة)
  shippingZonesEnabled      Boolean  @default(false)
  /// «أعلمني عند التوفر» بالبريد بدل رسالة واتساب
  stockAlertsEnabled        Boolean  @default(true)
  /// مغذّي المنتجات /feeds/products.xml لكتالوج فيسبوك/غوغل
  productFeedEnabled        Boolean  @default(true)
  // ---- الولاء ----
  loyaltyEnabled            Boolean  @default(false)
  /// كل كم ليرة من الطلب المؤكَّد تُمنح نقطة (مثال 10000 → طلب 300 ألف = 30 نقطة)
  pointsPerSyp              Int      @default(10000)
  /// قيمة النقطة بالليرة عند الاستبدال
  pointValue                Int      @default(500)
  /// أقل رصيد يسمح بالاستبدال
  minRedeemPoints           Int      @default(20)
  /// أقصى نسبة من الطلب تُدفع بالنقاط
  maxRedeemPercent          Int      @default(30)
  /// سقف قيمة النقاط المستبدَلة شهرياً بالليرة (0 = بلا سقف)
  loyaltyMonthlyBudget      Int      @default(0)
  // ---- الإحالة ----
  referralEnabled           Boolean  @default(false)
  /// نسبة كوبون الإحالة للطرفين
  referralPercent           Int      @default(10)
  referralMaxDiscount       Int      @default(50000)
  referralCouponDays        Int      @default(30)
  /// أقصى عدد إحالات مكافأة في الشهر (0 = بلا سقف)
  referralMonthlyCap        Int      @default(0)
  // ---- بريد السلة المتروكة ----
  abandonedCartEmailEnabled Boolean  @default(false)
  /// بعد كم ساعة من آخر تعديل تُرسل رسالة «سلتك بانتظارك» للمسجّلين
  abandonedCartHours        Int      @default(24)
  // ---- كوبون الترحيب ----
  welcomeCouponEnabled      Boolean  @default(false)
  welcomePercent            Int      @default(10)
  welcomeMaxDiscount        Int      @default(50000)
  welcomeMinOrder           Int      @default(0)
  welcomeCouponDays         Int      @default(7)
  /// أقصى عدد كوبونات ترحيب في الشهر (0 = بلا سقف)
  welcomeMonthlyCap         Int      @default(0)
  updatedAt                 DateTime @updatedAt

  @@map("site_settings")
}

/// منطقة شحن (Odoo delivery rules): محافظة بتكلفة ومدة توقّع.
model ShippingZone {
  id        String  @id @default(cuid())
  name      String  @unique
  cost      Int
  /// مثال: «2–3 أيام»
  etaText   String?
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  @@map("shipping_zones")
}

enum PromotionKind {
  /// خصم نسبة مئوية عند تجاوز مبلغ
  PERCENT_OVER_AMOUNT
  /// هدية (منتج) عند تجاوز مبلغ
  GIFT_OVER_AMOUNT
  /// اشترِ X من منتج واحصل على Y من منتج (قد يكون نفسه) مجاناً
  BUY_X_GET_Y
}

/// عرض تلقائي بلا كود (Odoo promotion program) — يُطبَّق في السلة إن تحققت شروطه،
/// وله ميزانية شهرية اختيارية تحمي الأدمن من تجاوز ما رصده.
model Promotion {
  id            String         @id @default(cuid())
  title         String
  kind          PromotionKind
  active        Boolean        @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  /// الحد الأدنى للمجموع (لأنواع «عند تجاوز مبلغ»)
  minSubtotal   Int            @default(0)
  percent       Int            @default(0)
  maxDiscount   Int?
  buyProductId  String?
  buyQty        Int            @default(1)
  giftProductId String?
  giftQty       Int            @default(1)
  /// تُعرض رسالة «أضف X لتحصل على…» في السلة
  showProgress  Boolean        @default(true)
  /// سقف قيمة الخصم/الهدايا في الشهر بالليرة (0 = بلا سقف)
  monthlyBudget Int            @default(0)
  uses          PromotionUse[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([active, startsAt, endsAt])
  @@map("promotions")
}

/// استخدام عرض في طلب — أساس حساب الميزانية الشهرية
model PromotionUse {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// قيمة الخصم أو الهدية بالليرة
  amount      Int
  createdAt   DateTime  @default(now())

  @@index([promotionId, createdAt])
  @@map("promotion_uses")
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}

enum EventType {
  PRODUCT_VIEW
  ADD_TO_CART
  WHATSAPP_CLICK
  CHECKOUT
  SEARCH
}

/// حدث سلوكي مجهول الهوية يغذّي لوحة المؤشرات (لا IP ولا كوكي). يُحذف بعد 90 يوماً.
model Event {
  id        String    @id @default(cuid())
  type      EventType
  /// معرّف المنتج، أو عبارة البحث، أو سياق نقرة واتساب
  key       String?
  /// عدد نتائج البحث مثلاً — صفر يعني «بحث بلا نتيجة»
  value     Int?
  createdAt DateTime  @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@map("events")
}

/// سجلّ تغييرات اللوحة (Odoo chatter): من غيّر ماذا ومتى، مع القيم قبل وبعد للحقول المتغيّرة فقط.
model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  label     String?
  changes   Json?
  actor     String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
}

/// حملة بريدية (Odoo Email Marketing): نص Markdown يُرسل لمن وافق على العروض،
/// مع تتبّع الفتح بصورة شفافة ورابط إلغاء اشتراك في كل رسالة.
model Campaign {
  id              String              @id @default(cuid())
  subject         String
  body            String
  status          CampaignStatus      @default(DRAFT)
  recipientsCount Int                 @default(0)
  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)
  openCount       Int                 @default(0)
  sentAt          DateTime?
  recipients      CampaignRecipient[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, createdAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// رمز صورة التتبّع الشفافة
  token      String    @unique
  sentAt     DateTime?
  openedAt   DateTime?
  error      String?

  @@unique([campaignId, customerId])
  @@index([campaignId, sentAt])
  @@map("campaign_recipients")
}
